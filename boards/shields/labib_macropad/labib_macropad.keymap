#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp F13 &kp F14 &kp F15
                &kp F16 &kp F17 &kp F18
                &kp F19 &kp F20 &mo 1
            >;
        };

        lower_layer {
            bindings = <
                &bt BT_CLR_ALL &kp F22 &kp F23
                &kp F24        &kp F25 &kp F26
                &kp F27        &kp F28 &kp F29
            >;
        };
    };
};